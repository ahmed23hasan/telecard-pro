rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ========================================================================
    // 🛡️ دوال التحقق الأمني الأساسية (Core Auth & Role Helpers)
    // ========================================================================
    function isAuthenticated() { 
      return request.auth != null; 
    }
    
    function isMasterAdmin() { 
      return isAuthenticated() && ('admin' in request.auth.token && request.auth.token.admin == true); 
    }
    
    function isNotBanned() { 
      return isAuthenticated() && (!('banned' in request.auth.token) || request.auth.token.banned != true); 
    }

    // 🛡️ التحقق الصارم من أن الملف المرفوع صورة نقطية حقيقية (يمنع image/svg+xml لمنع Stored XSS)
    function isImage() {
      return request.resource != null 
             && request.resource.contentType.matches('^image/(jpeg|jpg|png|webp)$')
             && request.resource.name.matches('.*\\.(jpg|jpeg|png|webp|JPG|JPEG|PNG|WEBP)$');
    }

    // 🛡️ التحقق الصارم من أن الملف المرفوع صورة نقطية آمنة أو مستند PDF رسمي
    function isImageOrPdf() {
      return request.resource != null && (
             (request.resource.contentType.matches('^image/(jpeg|jpg|png|webp)$') && request.resource.name.matches('.*\\.(jpg|jpeg|png|webp|JPG|JPEG|PNG|WEBP)$')) || 
             (request.resource.contentType == 'application/pdf' && request.resource.name.matches('.*\\.(pdf|PDF)$'))
      );
    }

    // 🛡️ تقييد حجم الملف بالميجابايت لحماية مساحة التخزين ومنع استنزاف الفوترة
    function isValidSize(maxSizeMB) {
      return request.resource != null && request.resource.size > 0 && request.resource.size <= maxSizeMB * 1024 * 1024;
    }

    // ========================================================================
    // 👑 صلاحية المدير العام الشاملة (Master Admin Sovereignty)
    // ========================================================================
    match /{allPaths=**} {
      allow read, write: if isMasterAdmin();
    }

    // ========================================================================
    // 🧾 1. إيصالات الإيداع المالي (Deposit Receipts)
    // ========================================================================
    match /receipts/{fileName} {
      allow read: if (isAuthenticated() && fileName.matches('^' + request.auth.uid + '_.*\\.(jpg|jpeg|png|webp|pdf|JPG|JPEG|PNG|WEBP|PDF)$')) || isMasterAdmin();
      allow create: if isAuthenticated() && isNotBanned()
                   && fileName.matches('^' + request.auth.uid + '_.*\\.(jpg|jpeg|png|webp|pdf|JPG|JPEG|PNG|WEBP|PDF)$')
                   && isImageOrPdf()
                   && isValidSize(10);
      allow delete: if isMasterAdmin();
    }

    // ========================================================================
    // 👤 2. الصور الرمزية للعملاء (User Avatars)
    // ========================================================================
    match /avatars/{fileName} {
      allow read: if true; 
      allow create, update: if isAuthenticated() && isNotBanned()
                   && fileName.matches('^avatar_' + request.auth.uid + '_.*\\.(jpg|jpeg|png|webp|JPG|JPEG|PNG|WEBP)$')
                   && isImage() 
                   && isValidSize(5); 
      allow delete: if (isAuthenticated() && fileName.matches('^avatar_' + request.auth.uid + '_.*\\.(jpg|jpeg|png|webp|JPG|JPEG|PNG|WEBP)$')) || isMasterAdmin();
    }

    // ========================================================================
    // 🪪 3. وثائق توثيق الهوية الجنائية (KYC Documents)
    // ========================================================================
    match /kyc_docs/{fileName} {
      allow read: if (isAuthenticated() && fileName.matches('^' + request.auth.uid + '_.*\\.(jpg|jpeg|png|webp|pdf|JPG|JPEG|PNG|WEBP|PDF)$')) || isMasterAdmin();
      allow create, update: if isAuthenticated() && isNotBanned()
                   && fileName.matches('^' + request.auth.uid + '_.*\\.(jpg|jpeg|png|webp|pdf|JPG|JPEG|PNG|WEBP|PDF)$')
                   && isImageOrPdf()
                   && isValidSize(10);
      allow delete: if isMasterAdmin();
    }

    // ========================================================================
    // 🏪 4. مجلدات العرض العامة للمتجر (Public Catalog Assets)
    // ========================================================================
    match /products/{allPaths=**} { allow read: if true; }
    match /categories/{allPaths=**} { allow read: if true; }
    match /general/{allPaths=**} { allow read: if true; }
    match /banners/{allPaths=**} { allow read: if true; }
    match /brand/{allPaths=**} { allow read: if true; }
    match /payments/{allPaths=**} { allow read: if true; } 

    // ========================================================================
    // 🔒 5. مجلد الإدارة الخاص (Restricted Admin Storage)
    // ========================================================================
    match /admin/{allPaths=**} { 
      allow read, write: if isMasterAdmin(); 
    }
  }
}