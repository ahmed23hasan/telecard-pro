rules_version = '2';
service firebase.storage {
match /b/{bucket}/o {

// ==========================================
// 🛠️ دوال التحقق الأساسية
// ==========================================
function isMasterAdmin() {
return request.auth != null && (request.auth.token.email == 'admin@telecard.pro' || request.auth.uid == 'e064MQJyn6dhU9mNXZvXItc7VYg2');
}

function isAuthenticated() {
return request.auth != null;
}

function isOwner(userId) {
return isAuthenticated() && request.auth.uid == userId;
}

// ==========================================
// 👑 صلاحيات الإدارة المطلقة
// ==========================================
match /{allPaths=**} {
allow read, write: if isMasterAdmin();
}

// ==========================================
// 🧾 إيصالات الدفع (محمية ومخصصة لكل عميل)
// ==========================================
match /receipts/{userId}/{fileName} {
allow read, write: if isOwner(userId);
}

// ==========================================
// 👤 الصور الشخصية (مفتوحة للقراءة، والكتابة للعميل نفسه)
// ==========================================
match /avatars/{fileName} {
allow read: if true;
allow write: if isAuthenticated() && fileName.matches('avatar_' + request.auth.uid + '.*');
}

// ==========================================
// 🛡️ التوثيق الأمني KYC (أعلى درجات السرية)
// ==========================================
match /kyc_docs/{fileName} {
allow read: if false;
allow write: if isAuthenticated() && fileName.matches(request.auth.uid + '_.*');
}

// ==========================================
// 🖼️ الملفات العامة للمتجر (للعرض فقط)
// ==========================================
match /products/{allPaths=**} { allow read: if true; }
match /categories/{allPaths=**} { allow read: if true; }
match /general/{allPaths=**} { allow read: if true; }
match /banners/{allPaths=**} { allow read: if true; }
match /brand/{allPaths=**} { allow read: if true; }
}
}