rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ==========================================
    // 🛠️ دوال التحقق الأساسية (Core Functions)
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return isAuthenticated() && (
        request.auth.uid == 'e064MQJyn6dhU9mNXZvXItc7VYg2' || 
        ('admin' in request.auth.token && request.auth.token.admin == true)
      );
    }

    // ==========================================
    // 🛡️ دوال حماية البيانات (Spoofing-Proof)
    // ==========================================
    
    // فحص المحتوى + الامتداد الحقيقي للملف (يمنع رفع فايروسات بصيغة صور)
    function isImage() {
      return request.resource != null 
             && request.resource.contentType.matches('^image/.*')
             && request.resource.name.matches('.*\\.(jpg|jpeg|png|webp)$');
    }

    function isImageOrPdf() {
      return request.resource != null && (
             (request.resource.contentType.matches('^image/.*') && request.resource.name.matches('.*\\.(jpg|jpeg|png|webp)$')) || 
             (request.resource.contentType == 'application/pdf' && request.resource.name.matches('.*\\.pdf$'))
      );
    }

    function isValidSize(maxSizeMB) {
      return request.resource != null && request.resource.size <= maxSizeMB * 1024 * 1024;
    }

    // ==========================================
    // 👑 صلاحيات الإدارة المطلقة
    // ==========================================
    // قاعدة الإدارة توضع في الأعلى لتخطي كل القواعد الأخرى عند الحاجة
    match /{allPaths=**} {
      allow read, write: if isMasterAdmin();
    }

    // ==========================================
    // 🧾 إيصالات الدفع
    // ==========================================
    match /receipts/{fileName} {
      // 🔒 إجبار بدء الاسم بـ dep_ والـ UID الخاص بالعميل
      allow read: if isAuthenticated() && fileName.matches('^dep_' + request.auth.uid + '_[a-zA-Z0-9_-]+\\.(jpg|jpeg|png|webp|pdf)$');
      
      allow create: if isAuthenticated()
                   && fileName.matches('^dep_' + request.auth.uid + '_[a-zA-Z0-9_-]+\\.(jpg|jpeg|png|webp|pdf)$')
                   && isImageOrPdf()
                   && isValidSize(5);
                   
      allow delete: if isAuthenticated() && fileName.matches('^dep_' + request.auth.uid + '_[a-zA-Z0-9_-]+\\.(jpg|jpeg|png|webp|pdf)$');
    }

    // ==========================================
    // 👤 الصور الشخصية للعملاء
    // ==========================================
    match /avatars/{fileName} {
      allow read: if true;
      
      // 🔒 إجبار صورة واحدة فقط لكل عميل (Overwrite)
      allow create, update: if isAuthenticated() 
                   && fileName.matches('^avatar_' + request.auth.uid + '\\.(jpg|jpeg|png|webp)$')
                   && isImage() 
                   && isValidSize(3);
                   
      allow delete: if isAuthenticated() 
                   && fileName.matches('^avatar_' + request.auth.uid + '\\.(jpg|jpeg|png|webp)$');
    }

    // ==========================================
    // 🛡️ التوثيق الأمني KYC (مضاد للاستنزاف 100%)
    // ==========================================
    match /kyc_docs/{fileName} {
      // 🔒 يُسمح بملفين اثنين حصراً (document أو selfie)
      allow read: if isAuthenticated() && fileName.matches('^' + request.auth.uid + '_(document|selfie)\\.(jpg|jpeg|png|webp)$');
      
      allow create, update: if isAuthenticated() 
                   && fileName.matches('^' + request.auth.uid + '_(document|selfie)\\.(jpg|jpeg|png|webp)$')
                   && isImage()
                   && isValidSize(8);
                   
      allow delete: if isAuthenticated() && fileName.matches('^' + request.auth.uid + '_(document|selfie)\\.(jpg|jpeg|png|webp)$');
    }

    // ==========================================
    // 🖼️ الملفات العامة للمتجر والإدارة (للعرض فقط)
    // ==========================================
    match /products/{allPaths=**} { allow read: if true; }
    match /categories/{allPaths=**} { allow read: if true; }
    match /general/{allPaths=**} { allow read: if true; }
    match /banners/{allPaths=**} { allow read: if true; }
    match /brand/{allPaths=**} { allow read: if true; }
    match /admin/{allPaths=**} { allow read: if true; }
  }
}