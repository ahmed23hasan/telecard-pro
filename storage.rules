rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ==========================================
    // 🛠️ دوال التحقق الأساسية (Core Functions)
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return isAuthenticated() && (
        request.auth.uid == 'e064MQJyn6dhU9mNXZvXItc7VYg2' || 
        ('admin' in request.auth.token && request.auth.token.admin == true)
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ==========================================
    // 🛡️ دوال حماية البيانات (مضادة للتحايل Spoofing-Proof)
    // ==========================================
    
    // فحص المحتوى + الامتداد الحقيقي للملف (يمنع رفع فايروسات بصيغة صور)
    function isImage() {
      return request.resource != null 
             && request.resource.contentType.matches('image/.*')
             && request.resource.name.matches('.*\\.(jpg|jpeg|png|webp)$'); // منع SVG (يحتوي ثغرات XSS) و GIF
    }

    function isImageOrPdf() {
      return request.resource != null && (
             (request.resource.contentType.matches('image/.*') && request.resource.name.matches('.*\\.(jpg|jpeg|png|webp)$')) || 
             (request.resource.contentType == 'application/pdf' && request.resource.name.matches('.*\\.pdf$'))
      );
    }

    function isValidSize(maxSizeMB) {
      return request.resource != null && request.resource.size <= maxSizeMB * 1024 * 1024;
    }

    // ==========================================
    // 👑 صلاحيات الإدارة المطلقة
    // ==========================================
    match /{allPaths=**} {
      allow read, write: if isMasterAdmin();
    }

    // ==========================================
    // 🧾 إيصالات الدفع
    // ==========================================
    match /receipts/{fileName} {
      allow read: if isAuthenticated() && fileName.matches('dep_' + request.auth.uid + '_.*');
      allow create: if isAuthenticated()
                   && fileName.matches('dep_' + request.auth.uid + '_.*')
                   && isImageOrPdf()
                   && isValidSize(5);
                   
      // السماح بالحذف إذا أراد العميل التراجع قبل الاعتماد (اختياري وآمن)
      allow delete: if isAuthenticated() && fileName.matches('dep_' + request.auth.uid + '_.*');
    }

    // ==========================================
    // 👤 الصور الشخصية للعملاء
    // ==========================================
    match /avatars/{fileName} {
      allow read: if true;
      allow create, update: if isAuthenticated() 
                   && fileName.matches('avatar_' + request.auth.uid + '.*')
                   && isImage() 
                   && isValidSize(3);
                   
      allow delete: if isAuthenticated() 
                   && fileName.matches('avatar_' + request.auth.uid + '.*');
    }

    // ==========================================
    // 🛡️ التوثيق الأمني KYC
    // ==========================================
    match /kyc_docs/{fileName} {
      allow read: if isAuthenticated() && fileName.matches(request.auth.uid + '_.*');
      
      allow create: if isAuthenticated() 
                   && fileName.matches(request.auth.uid + '_.*')
                   && isImage()
                   && isValidSize(8);
                   
      // ✅ [الترقيع المالي]: السماح للعميل بحذف صوره القديمة عند إعادة تقديم التوثيق لمنع تكدس السحابة بفواتير وهمية
      allow delete: if isAuthenticated() && fileName.matches(request.auth.uid + '_.*');
    }

    // ==========================================
    // 🖼️ الملفات العامة للمتجر والإدارة (للعرض فقط)
    // ==========================================
    match /products/{allPaths=**} { allow read: if true; }
    match /categories/{allPaths=**} { allow read: if true; }
    match /general/{allPaths=**} { allow read: if true; }
    match /banners/{allPaths=**} { allow read: if true; }
    match /brand/{allPaths=**} { allow read: if true; }
    match /admin/{allPaths=**} { allow read: if true; }
  }
}