rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ==========================================
    // 🛠️ دوال التحقق الأساسية (Core Functions)
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      // 🛡️ [الإصلاح الأمني]: الاعتماد حصرياً على الـ Token الموثق من السيرفر (إزالة الباب الخلفي)
      return isAuthenticated() && ('admin' in request.auth.token && request.auth.token.admin == true);
    }

    // ==========================================
    // 🛡️ دوال حماية البيانات (Spoofing & Polyglot Proof)
    // ==========================================
    function isImage() {
      return request.resource != null 
             && request.resource.contentType.matches('^image/.*')
             && request.resource.name.matches('.*\\.(jpg|jpeg|png|webp)$');
    }

    function isImageOrPdf() {
      return request.resource != null && (
             (request.resource.contentType.matches('^image/.*') && request.resource.name.matches('.*\\.(jpg|jpeg|png|webp)$')) || 
             (request.resource.contentType == 'application/pdf' && request.resource.name.matches('.*\\.pdf$'))
      );
    }

    function isValidSize(maxSizeMB) {
      return request.resource != null && request.resource.size <= maxSizeMB * 1024 * 1024;
    }

    // ==========================================
    // 👑 صلاحيات الإدارة المطلقة
    // ==========================================
    match /{allPaths=**} {
      allow read, write: if isMasterAdmin();
    }

    // ==========================================
    // 🧾 إيصالات الدفع (Receipts Sandboxing)
    // ==========================================
    match /receipts/{fileName} {
      // 🛡️ متطابق مع الواجهة: deposit_UID_Timestamp_UUID.webp
      allow read: if isAuthenticated() && fileName.matches('^deposit_' + request.auth.uid + '_.*\\.(jpg|jpeg|png|webp|pdf)$');
      
      allow create: if isAuthenticated()
                   && fileName.matches('^deposit_' + request.auth.uid + '_.*\\.(jpg|jpeg|png|webp|pdf)$')
                   && isImageOrPdf()
                   && isValidSize(10);
                   
      allow delete: if isAuthenticated() && fileName.matches('^deposit_' + request.auth.uid + '_.*\\.(jpg|jpeg|png|webp|pdf)$');
    }

    // ==========================================
    // 👤 الصور الشخصية للعملاء (Avatar Overwrite)
    // ==========================================
    match /avatars/{fileName} {
      allow read: if true; // مسموح للجميع برؤية الصورة الشخصية
      
      allow create, update: if isAuthenticated() 
                   && fileName.matches('^avatar_' + request.auth.uid + '_.*\\.(jpg|jpeg|png|webp)$')
                   && isImage() 
                   && isValidSize(5); 
                   
      allow delete: if isAuthenticated() 
                   && fileName.matches('^avatar_' + request.auth.uid + '_.*\\.(jpg|jpeg|png|webp)$');
    }

    // ==========================================
    // 🛡️ التوثيق الأمني KYC (مضاد للاستنزاف وسرقة الهوية)
    // ==========================================
    match /kyc_docs/{fileName} {
      // 🏦 المعيار البنكي الصارم: لا يمكن لأي شخص قراءة الهوية بعد رفعها إلا الإدارة
      allow read: if isMasterAdmin();
      
      // 💡 (ملاحظة: إذا أردت يوماً السماح للعميل برؤية هويته المرفوعة، احذف السطر الأعلى وفعل السطر التالي)
      // allow read: if isMasterAdmin() || (isAuthenticated() && fileName.matches('^kyc_' + request.auth.uid + '.*'));
      
      allow create, update: if isAuthenticated() 
                   && fileName.matches('^kyc_' + request.auth.uid + '_(front|back|selfie)_.*\\.(jpg|jpeg|png|webp)$')
                   && isImage()
                   && isValidSize(8);
                   
      allow delete: if isAuthenticated() && fileName.matches('^kyc_' + request.auth.uid + '_(front|back|selfie)_.*\\.(jpg|jpeg|png|webp)$');
    }

    // ==========================================
    // 🖼️ الملفات العامة للمتجر والإدارة (للعرض فقط Public Read)
    // ==========================================
    match /products/{allPaths=**} { allow read: if true; }
    match /categories/{allPaths=**} { allow read: if true; }
    match /general/{allPaths=**} { allow read: if true; }
    match /banners/{allPaths=**} { allow read: if true; }
    match /brand/{allPaths=**} { allow read: if true; }
    match /admin/{allPaths=**} { allow read: if true; }
    match /payments/{allPaths=**} { allow read: if true; } 
  }
}