rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ==========================================
    // 🛠️ دوال التحقق الأساسية (Core Functions)
    // ==========================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isMasterAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true || 
        request.auth.token.email == 'admin@telecard.pro' || 
        request.auth.uid == 'e064MQJyn6dhU9mNXZvXItc7VYg2'
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ==========================================
    // 🛡️ دوال حماية البيانات (تأكدنا من وجود resource لمنع أخطاء الحذف)
    // ==========================================
    function isImage() {
      return request.resource != null && request.resource.contentType.matches('image/.*');
    }

    function isImageOrPdf() {
      return request.resource != null && (
             request.resource.contentType.matches('image/.*') || 
             request.resource.contentType == 'application/pdf');
    }

    function isValidSize(maxSizeMB) {
      return request.resource != null && request.resource.size <= maxSizeMB * 1024 * 1024;
    }

    // ==========================================
    // 👑 صلاحيات الإدارة المطلقة
    // ==========================================
    match /{allPaths=**} {
      allow read, write: if isMasterAdmin();
    }

// ==========================================
// 🧾 إيصالات الدفع (Create-Only لمنع التلاعب)
// ==========================================
match /receipts/{fileName} {
allow read: if isAuthenticated() && fileName.matches('dep_' + request.auth.uid + '_.*');
allow create: if isAuthenticated()
&& fileName.matches('dep_' + request.auth.uid + '_.*')
&& isImageOrPdf()
&& isValidSize(5);
}
    // ==========================================
    // 👤 الصور الشخصية للعملاء
    // ==========================================
    match /avatars/{fileName} {
      allow read: if true;
      // 🛡️ [ترقيع أمني]: فصلنا الإنشاء والتحديث عن الحذف لمنع انهيار الكود
      allow create, update: if isAuthenticated() 
                   && fileName.matches('avatar_' + request.auth.uid + '.*')
                   && isImage() 
                   && isValidSize(3);
                   
      allow delete: if isAuthenticated() 
                   && fileName.matches('avatar_' + request.auth.uid + '.*');
    }

    // ==========================================
    // 🛡️ التوثيق الأمني KYC (Create-Only)
    // ==========================================
    match /kyc_docs/{fileName} {
      allow read: if isAuthenticated() && fileName.matches(request.auth.uid + '_.*');
      // 🛡️ [ترقيع أمني]: يسمح برفع الهوية مرة واحدة لمنع التلاعب بعد تقديم الطلب
      allow create: if isAuthenticated() 
                   && fileName.matches(request.auth.uid + '_.*')
                   && isImage()
                   && isValidSize(8);
    }

    // ==========================================
    // 🖼️ الملفات العامة للمتجر والإدارة
    // ==========================================
    match /products/{allPaths=**} { allow read: if true; }
    match /categories/{allPaths=**} { allow read: if true; }
    match /general/{allPaths=**} { allow read: if true; }
    match /banners/{allPaths=**} { allow read: if true; }
    match /brand/{allPaths=**} { allow read: if true; }
    match /admin/{allPaths=**} { allow read: if true; }
  }
}