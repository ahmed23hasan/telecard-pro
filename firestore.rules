rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 🛠️ دوال التحقق الأساسية (Core Authentication)
    // ==========================================
    function isAuthenticated() { return request.auth != null; }
    
    function isMasterAdmin() {
      return isAuthenticated() && ('admin' in request.auth.token && request.auth.token.admin == true);
    }    
    
    function isNotBanned() { 
      return isAuthenticated() && (!('banned' in request.auth.token) || request.auth.token.banned != true); 
    }
    
    function isOwner(userId) { return isAuthenticated() && request.auth.uid == userId; }

    // ==========================================
    // 🛡️ دروع حماية ملف المستخدم (Profile Firewalls)
    // ==========================================
    function isStandardProfileUpdate() {
      // 🚀 الإصلاح: إضافة 'adminMessage' ليتمكن العميل من إخفاء الرسالة بعد قراءتها
      let allowedKeys = ['name', 'firstName', 'lastName', 'fullName', 'username', 'img', 'phone', 'country', 'theme', 'devicePrints', 'passwordChangeHistory', 'biometricEnabled', 'readAlerts', 'baseCurrency', 'base_currency', 'adminMessage'];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys);
    }

    function isSecureKycSubmission() {
      let diff = request.resource.data.diff(resource.data);
      let isOnlyKycFields = diff.affectedKeys().hasOnly(['kycStatus', 'kycData', 'fullName', 'country', 'phone']);
      let isSettingToPending = request.resource.data.kycStatus == 'pending';
      let isCurrentlyNotApproved = resource.data.get('kycStatus', 'none') != 'approved' && resource.data.get('kycStatus', 'none') != 'verified';
      return isOnlyKycFields && isSettingToPending && isCurrentlyNotApproved;
    }

    function isSafeUserCreation() {
      let data = request.resource.data;
      
      let safeValues = data.get('walletBalance', 0) == 0 &&
                       data.get('balance', 0) == 0 &&
                       data.get('totalSpent', 0) == 0 &&
                       data.get('totalDeposit', 0) == 0 &&
                       data.get('role', 'user') != 'admin' &&
                       data.get('isBanned', false) == false &&
                       data.get('isIpBanned', false) == false;
      
      let allowedCreationKeys = [
        'id', 'uid', 'displayId', 
        'firstName', 'lastName', 'fullName', 'name', 'username', 'email', 'img',
        'baseCurrency', 'base_currency', 'phone', 'country', 
        'walletBalance', 'balance', 'totalSpent', 'totalDeposit', 
        'tierId', 'tierCycleSpent', 'tierCycleStartDate', 
        'role', 'isVerified', 'kycStatus', 'isBanned', 'isIpBanned', 'createdAt', 'provider'
      ];
      
      return safeValues && data.keys().hasOnly(allowedCreationKeys);
    }

    // ==========================================
    // 👥 إدارة المستخدمين (User Profiles)
    // ==========================================
    match /telecard_users/{userId} {
      allow read: if (isOwner(userId) && isNotBanned()) || isMasterAdmin();
      allow update: if (isOwner(userId) && isNotBanned() && (isStandardProfileUpdate() || isSecureKycSubmission())) || isMasterAdmin();
      allow create: if isOwner(userId) && isSafeUserCreation();
      allow delete: if isMasterAdmin();

      match /notifications/{notifId} {
        allow read: if isOwner(userId);
        allow update: if isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt', 'views']);
        allow create, delete: if isMasterAdmin();
      }
    }

    // ==========================================
    // 🌐 المجموعات العامة و 🎟️ الكوبونات (Public Catalog)
    // ==========================================
    match /telecard_tiers/{docId} { allow read: if true; allow write: if isMasterAdmin(); }
    match /telecard_cats/{docId} { allow read: if true; allow write: if isMasterAdmin(); }
    match /telecard_settings/{docId} { allow read: if true; allow write: if isMasterAdmin(); }
    match /telecard_alerts/{docId} { allow read: if true; allow write: if isMasterAdmin(); }
    match /telecard_payments/{docId} { allow read: if true; allow write: if isMasterAdmin(); }
    match /telecard_banners/{docId} { allow read: if true; allow write: if isMasterAdmin(); }
    match /telecard_rates/{docId} { allow read: if true; allow write: if isMasterAdmin(); }
    match /telecard_countries/{docId} { allow read: if true; allow write: if isMasterAdmin(); }
    match /telecard_offers/{docId} { allow read: if true; allow write: if isMasterAdmin(); }
    match /telecard_prods_public/{docId} { allow read: if true; allow write: if isMasterAdmin(); }
    
    match /telecard_coupons/{docId} { 
      allow read: if isAuthenticated() && isNotBanned(); allow write: if isMasterAdmin(); 
    }

    // ==========================================
    // 🔒 البيانات المحمية - كتابة السيرفر فقط (Server-Only Writes)
    // ==========================================
    match /telecard_prods/{docId} { allow read, write: if isMasterAdmin(); } 
    
    match /telecard_orders/{docId} {
      allow read: if (isOwner(resource.data.userId) && isNotBanned()) || isMasterAdmin();
      allow write: if isMasterAdmin();
    }

    match /telecard_deposits/{docId} {
      allow read: if (isOwner(resource.data.userId) && isNotBanned()) || isMasterAdmin();
      allow write: if isMasterAdmin();
    }

    // ==========================================
    // 💬 التقييمات والـ KYC
    // ==========================================
    
    // 🚀 الإصلاح الجذري: توجيه التقييمات للقسم الجديد (reviews) وتفعيل حماية الإغراق (Anti-Spam Upsert)
    match /reviews/{reviewId} {
      allow read, delete: if isMasterAdmin();
      // السماح بإنشاء أو تحديث التقييم فقط إذا كان الـ ID للمستند يطابق ID العميل (لا يمكنه إنشاء مستندات عشوائية)
      allow create, update: if isNotBanned() 
                            && request.auth.uid == reviewId 
                            && request.resource.data.userId == request.auth.uid
                            && request.resource.data.rating is int 
                            && request.resource.data.rating >= 0 
                            && request.resource.data.rating <= 5;
    }

    match /telecard_kyc/{docId} {
      allow read: if isOwner(resource.data.userId) || isMasterAdmin();
      allow create: if isOwner(request.resource.data.userId) && isNotBanned()
                    && request.resource.data.keys().hasOnly(['userId', 'fullName', 'documentUrl', 'selfieUrl', 'status', 'createdAt', 'updatedAt'])
                    && request.resource.data.status == 'pending';
      allow update, delete: if isMasterAdmin();
    }

    // ==========================================
    // 🔒 الخزنات والأنظمة الحساسة (Admin Only)
    // ==========================================
    match /telecard_vault/{document=**} { allow read, write: if isMasterAdmin(); }
    match /telecard_admin/{document=**} { allow read, write: if isMasterAdmin(); }
    match /telecard_system/{docId} {
      allow read: if docId == 'cache_version' || isMasterAdmin();
      allow write: if isMasterAdmin();
    }
    match /telecard_system/{docId}/{document=**} {
      allow read, write: if isMasterAdmin();
    }
    match /telecard_logs/{document=**} { allow read, write: if isMasterAdmin(); }
    match /telecard_idempotency_keys/{document=**} { allow read, write: if isMasterAdmin(); }
    match /telecard_failed_webhooks/{document=**} { allow read, write: if isMasterAdmin(); }
    match /telecard_suppliers/{document=**} { allow read, write: if isMasterAdmin(); }
    match /telecard_audit_logs/{document=**} { allow read, write: if isMasterAdmin(); }

    match /{document=**} { allow read, write: if isMasterAdmin(); }
  }
}
