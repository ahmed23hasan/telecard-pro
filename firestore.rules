rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ==========================================
    // 🛠️ دوال التحقق الأساسية (Core Security Functions)
    // ==========================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // 🛡️ التحقق الصارم للإدارة (طريقة آمنة لا تنهار)
    function isMasterAdmin() {
      return isAuthenticated() && (
        request.auth.uid == 'e064MQJyn6dhU9mNXZvXItc7VYg2' || 
        ('admin' in request.auth.token && request.auth.token.admin == true)
      );
    }

    // 🛡️ [تم الإصلاح]: التحقق من الحظر (مضاد للانهيار للعملاء الجدد)
    function isNotBanned() {
      // إذا كان مسجلاً، وليس لديه صفة الحظر، فهو مسموح له بالدخول
      return isAuthenticated() && (!('banned' in request.auth.token) || request.auth.token.banned != true);
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 🛡️ القائمة البيضاء للحقول المسموح للعميل بتعديلها بعد الإنشاء
    function isOnlyUpdatingAllowedProfileFields() {
      let allowedKeys = [
        'name', 'firstName', 'lastName', 'fullName', 'username',
        'img', 'phone', 'country', 'theme', 'devicePrints', 
        'passwordChangeHistory', 'adminMessage', 'biometricEnabled'
      ];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys);
    }

    // 🛡️ التحقق من أمان إنشاء حساب جديد
    function isSafeUserCreation() {
      let data = request.resource.data;
      let safeWallet = data.get('walletBalance', 0) == 0;
      let safeBalance = data.get('balance', 0) == 0;
      let safeSpent = data.get('totalSpent', 0) == 0;
      let safeDeposit = data.get('totalDeposit', 0) == 0;
      let safeTier = data.get('tierId', 'TIER_DEFAULT_INITIAL') == 'TIER_DEFAULT_INITIAL' || data.get('tierId', '') == '';
      let notAdmin = data.get('role', 'user') != 'admin';
      let notBanned = data.get('isBanned', false) == false;
      let notIpBanned = data.get('isIpBanned', false) == false;
      
      return safeWallet && safeBalance && safeSpent && safeDeposit && safeTier && notAdmin && notBanned && notIpBanned;
    }

    // ==========================================
    // 👥 إدارة المستخدمين (Zero-Trust Security)
    // ==========================================
    match /telecard_users/{userId} {
      allow read: if (isOwner(userId) && isNotBanned()) || isMasterAdmin();
      allow update: if (isOwner(userId) && isNotBanned() && isOnlyUpdatingAllowedProfileFields()) || isMasterAdmin();
      allow create: if isOwner(userId) && isSafeUserCreation();
      allow delete: if isMasterAdmin();

      match /notifications/{notifId} {
        allow read: if isOwner(userId);
        allow update: if isOwner(userId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt', 'views']);
        allow create, delete: if isMasterAdmin();
      }
    }

    // ==========================================
    // 🌐 المجموعات العامة (للعرض فقط - Read Only)
    // ==========================================
    function canBrowsePublic() {
      return !isAuthenticated() || isNotBanned();
    }

    match /telecard_tiers/{docId} { allow read: if canBrowsePublic(); allow write: if isMasterAdmin(); }
    match /telecard_cats/{docId} { allow read: if canBrowsePublic(); allow write: if isMasterAdmin(); }
    match /telecard_settings/{docId} { allow read: if true; allow write: if isMasterAdmin(); }
    match /telecard_alerts/{docId} { allow read: if canBrowsePublic(); allow write: if isMasterAdmin(); }
    match /telecard_payments/{docId} { allow read: if canBrowsePublic(); allow write: if isMasterAdmin(); }
    match /telecard_banners/{docId} { allow read: if canBrowsePublic(); allow write: if isMasterAdmin(); }
    match /telecard_rates/{docId} { allow read: if canBrowsePublic(); allow write: if isMasterAdmin(); }
    match /telecard_countries/{docId} { allow read: if canBrowsePublic(); allow write: if isMasterAdmin(); }
    match /telecard_offers/{docId} { allow read: if canBrowsePublic(); allow write: if isMasterAdmin(); }
    match /telecard_prods_public/{docId} { allow read: if canBrowsePublic(); allow write: if isMasterAdmin(); }
    
    // ✅ تم الإصلاح: السماح للعميل بقراءة الكوبونات
    match /telecard_coupons/{docId} { allow read: if canBrowsePublic(); allow write: if isMasterAdmin(); }
    
    match /telecard_prods/{docId} { allow read, write: if isMasterAdmin(); }

    // ==========================================
    // 🛒 الطلبات والإيداعات (Write Locked)
    // ==========================================
    match /telecard_orders/{docId} {
      allow read: if (isOwner(resource.data.userId) && isNotBanned()) || isMasterAdmin();
      allow write: if isMasterAdmin(); 
    }

    match /telecard_deposits/{docId} {
      allow read: if (isOwner(resource.data.userId) && isNotBanned()) || isMasterAdmin();
      allow write: if isMasterAdmin(); 
    }

    // ==========================================
    // 💬 التقييمات وتأكيد التوثيق
    // ==========================================
    match /telecard_private_feedbacks/{docId} {
      allow create: if isNotBanned() 
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.keys().hasOnly(['userId', 'username', 'rating', 'feedback', 'time'])
                    && request.resource.data.rating is int 
                    && request.resource.data.rating >= 0 
                    && request.resource.data.rating <= 5
                    && request.resource.data.feedback is string
                    && request.resource.data.feedback.size() < 1000;
      allow read, update, delete: if isMasterAdmin();
    }

    match /telecard_kyc/{docId} {
      allow read: if isOwner(resource.data.userId) || isMasterAdmin();
      allow create: if isOwner(request.resource.data.userId) 
                    && isNotBanned()
                    && request.resource.data.keys().hasOnly(['userId', 'fullName', 'documentUrl', 'selfieUrl', 'status', 'createdAt', 'updatedAt'])
                    && request.resource.data.status == 'pending';
      allow update, delete: if isMasterAdmin();
    }

    // ==========================================
    // 🔒 المجموعات شديدة الحساسية (Recursive Server-Only Protection)
    // ==========================================
    match /telecard_vault/{document=**} { allow read, write: if isMasterAdmin(); }
    match /telecard_admin/{document=**} { allow read, write: if isMasterAdmin(); }
    match /telecard_system/{document=**} { allow read, write: if isMasterAdmin(); }
    match /telecard_logs/{document=**} { allow read, write: if isMasterAdmin(); }
    match /telecard_idempotency_keys/{document=**} { allow read, write: if isMasterAdmin(); }
    match /telecard_failed_webhooks/{document=**} { allow read, write: if isMasterAdmin(); }
    match /telecard_suppliers/{document=**} { allow read, write: if isMasterAdmin(); }

    // ==========================================
    // 🛑 القاعدة الجدارية الشاملة
    // ==========================================
    match /{document=**} {
      allow read, write: if isMasterAdmin();
    }

  }
}