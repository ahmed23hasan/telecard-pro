# ==========================================
# 💎 Telecard Pro Custom Ignores (Security & OS)
# ==========================================

# 1. OS Generated Files (ملفات أنظمة التشغيل المهملة)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# 2. Editor & IDE Directories (إعدادات محرر الأكواد الشخصية)
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 3. Security & Firebase Credentials (درع حماية الأسرار السحابية)
*serviceAccount*.json
*secret*.json
*.pem
*.key

# 4. Environment Variables (المتغيرات البيئية بكافة امتداداتها)
.env*
!.env.example

# 🔒 [تحديث حرج]: منع تسريب مفاتيح تهيئة الدوال المحلية في السيرفر
.runtimeconfig.json

# 5. Firebase Local Emulators State (بيانات المحاكيات المحلية)
firebase-export*/
firestore-debug.log
ui-debug.log

# 6. Compiled/Build Directories (تجاهل مجلدات البناء التلقائي لـ TS والـ Bundlers)
dist/
build/
lib/
out/

# 7. Telecard Workspace specific Temp folders (مجلدات العمل المؤقتة)
telecard-workspace/admin-tele/temp/
telecard-workspace/store-app/temp/
.turbo/
